
@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

actor "End User" as User
actor "Developer /\nAdministrator" as Admin
actor "LLM Service" as LLM
database "Neo4j Database" as DB

rectangle "AgentLens System" {
    usecase "UC-01\nSearch Products" as UC1
    usecase "UC-02\nGenerate Cypher Query" as UC2
    usecase "UC-03\nValidate Query" as UC3
    usecase "UC-04\nExecute Read-Only Query" as UC4
    usecase "UC-05\nView Search Results" as UC5
    usecase "UC-06\nHandle Processing Errors" as UC6
    usecase "UC-07\nConfigure Application" as UC7
    usecase "UC-08\nDiagnose Failures" as UC8
}

User -- UC1
User -- UC5

Admin -- UC7
Admin -- UC8

LLM -- UC2
DB -- UC4

UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

UC6 ..> UC1 : <<extend>>

note right of UC3
  Rejected queries must
  never reach execution.
end note

@enduml
